# Phoenix Security MCP server — environment configuration.
#
# Copy this file to `.env` and fill in your credentials:
#     cp .env.example .env
#
# `.env` is git-ignored — never commit real credentials.
# The server loads `.env` automatically (cwd or parent dirs), but only for
# variables NOT already set in the real environment. An MCP client's own
# `env` block always takes precedence.
#
# Credentials are created in the Phoenix UI: Organisation > API Access.
# The client secret is shown only once at creation time.

# --- Required ---------------------------------------------------------------
PHOENIX_CLIENT_ID=your-client-id
PHOENIX_CLIENT_SECRET=your-client-secret

# --- Environment (choose the one your credentials belong to) ----------------
# Production (default):      https://api.securityphoenix.cloud
# Demo:                      https://api.demo.appsecphx.io
# PoC:                       https://api.poc1.appsecphx.io
# Dedicated enterprise:      https://api.<tenant>.securityphoenix.cloud
PHOENIX_API_BASE_URL=https://api.demo.appsecphx.io

# --- Optional hardening / behaviour -----------------------------------------
# Disable ALL write tools (recommended when starting out):
PHOENIX_MCP_READ_ONLY=true
# Cap the number of items any list tool returns (default 100):
# PHOENIX_MCP_MAX_ITEMS=100
# Transport (stdio for Claude/Cursor/Codex; streamable-http for ChatGPT):
# PHOENIX_MCP_TRANSPORT=stdio
# PHOENIX_MCP_HOST=127.0.0.1
# PHOENIX_MCP_PORT=8848
